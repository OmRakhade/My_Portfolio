# ==========================================
# Root .gitignore for Portfolio AI Project
# ==========================================

# Environment & Secrets (Never commit API keys!)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem

# Python & Virtual Environments
.venv/
backend/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# TypeScript Build Info
*.tsbuildinfo
frontend/*.tsbuildinfo

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~

# Vercel
.vercel/

# Visitor uploaded / transient files (keep .gitkeep in system_documents)
backend/app/data/system_documents/*
!backend/app/data/system_documents/.gitkeep
